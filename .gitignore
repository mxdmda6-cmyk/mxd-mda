# ═══════════════════════════════════════════════════════
# 🜂 MXD-MDA TRANSMEDIA ORCHESTRATION SYSTEM
# Alchemical .gitignore - Protecting the Prima Materia
# ═══════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────
# SECRETS & CONFIGURATION (Critical Security)
# ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets/
credentials.json
service-account.json
config/production.yml
config/secrets.*

# API Keys (Platform-Specific)
**/ANTHROPIC_API_KEY*
**/DISCORD_TOKEN*
**/NOTION_API_KEY*
**/BEEHIIV_API_KEY*
**/KIT_API_KEY*
**/GEMINI_API_KEY*

# ─────────────────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
.python-version

# Distribution / Packaging
*.egg-info/
dist/
build/
wheels/
*.egg
.eggs/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type Checking & Linting
.mypy_cache/
.dmypy.json
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# ─────────────────────────────────────────────────────
# NODE & JAVASCRIPT
# ─────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.npm
.yarn/
package-lock.json
yarn.lock

# ─────────────────────────────────────────────────────
# MXD-MDA SYSTEM OUTPUTS
# ─────────────────────────────────────────────────────
# Generated Content
outputs/
generated/
exports/*
!exports/README.md
reports/
dashboards/

# Content Calendars (keep templates, ignore generated)
content_calendars/*.json
content_calendars/*.csv
!content_calendars/templates/

# Bot Logs & Data
logs/
*.log
bot_data/
discord_cache/
message_history/

# Kickstarter Campaign Artifacts
kickstarter_exports/
campaign_analytics/

# ─────────────────────────────────────────────────────
# DATABASES & VECTOR STORES
# ─────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
qdrant_data/
vector_db/
embeddings/

# ─────────────────────────────────────────────────────
# CLOUD & DEPLOYMENT
# ─────────────────────────────────────────────────────
# Fly.io
fly.toml.bak
.fly/

# Docker
docker-compose.override.yml

# Terraform (if using for infrastructure)
*.tfstate
*.tfstate.backup
.terraform/

# ─────────────────────────────────────────────────────
# OS & IDE
# ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─────────────────────────────────────────────────────
# BUILD & CACHE
# ─────────────────────────────────────────────────────
dist/
build/
.cache/
.temp/
tmp/

# ─────────────────────────────────────────────────────
# ASSETS (LFS tracked via .gitattributes)
# ─────────────────────────────────────────────────────
assets/**/*
!assets/README.md
!assets/cards/
!assets/cards/IMAGES.md

# ─────────────────────────────────────────────────────
# TEMPORARY & DEVELOPMENT
# ─────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
.scratch/
TODO_LOCAL.md
NOTES_PRIVATE.md

# ═══════════════════════════════════════════════════════
# End of Alchemical Protection
# "What is hidden shall remain hidden, until the time of revelation"
# ═══════════════════════════════════════════════════════
