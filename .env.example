# ═══════════════════════════════════════════════════════════════
# MXD-MDA — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
#
# HOW TO USE:
#   1. cp .env.example .env
#   2. Fill in the values below with your real credentials
#   3. NEVER commit .env to version control (already in .gitignore)
#
# For production/CI: inject secrets via your platform's secret
# manager (GitHub Actions Secrets, Railway, Fly.io, etc.)
# ═══════════════════════════════════════════════════════════════

# ── GitHub ──────────────────────────────────────────────────────
# Required scopes: repo, project, read:org
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# ── Supabase ─────────────────────────────────────────────────────
# Find in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# ── Anthropic / Claude ───────────────────────────────────────────
# Generate at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Gemini ───────────────────────────────────────────────────────
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── FastAPI ───────────────────────────────────────────────────────
FASTAPI_BASE_URL=http://localhost:8000

# ── AR Provider ──────────────────────────────────────────────────
AR_PROVIDER_NAME=8thwall
AR_PROVIDER_API_KEY=your_ar_provider_api_key_here

# ── Analytics ────────────────────────────────────────────────────
ANALYTICS_WRITE_KEY=your_analytics_write_key_here

# ── Public URLs ───────────────────────────────────────────────────
PUBLIC_SITE_URL=https://mxd-mda.example.com

# ── Discord (optional) ───────────────────────────────────────────
# DISCORD_BOT_TOKEN=your_discord_bot_token_here
# DISCORD_GUILD_ID=your_server_id_here

# ── IRS / Legal (local-only — fill immediately before SS-4 submission) ──
# Clear after PDF generation. NEVER commit a real SSN.
# RESPONSIBLE_PARTY_SSN=XXX-XX-XXXX
