# ═══════════════════════════════════════════════════════════════
# 🜂 MXD-MDA TRANSMEDIA ORCHESTRATION SYSTEM
# Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp config/.env.example .env
# 2. Fill in only the credentials for integrations you are actively testing
# 3. NEVER commit the .env file to git; it is ignored by .gitignore
# 4. Use GitHub Secrets for CI/CD environments
#
# IMPORTANT:
# These are placeholders, not example secrets. Do not paste real keys into
# documentation, GitHub issues, screenshots, shared chats, or commit history.
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# CORE AI SERVICES
# ─────────────────────────────────────────────────────────────

# Anthropic Claude API - optional until content generation is implemented
ANTHROPIC_API_KEY=replace-me

# Google Gemini API - optional future multi-agent coordination
GOOGLE_GEMINI_API_KEY=replace-me

# ─────────────────────────────────────────────────────────────
# DISCORD BOT INTEGRATION - disabled by default
# ─────────────────────────────────────────────────────────────

DISCORD_BOT_TOKEN=replace-me
DISCORD_APPLICATION_ID=replace-me
DISCORD_GUILD_ID=replace-me

# ─────────────────────────────────────────────────────────────
# NOTION INTEGRATION - disabled by default
# ─────────────────────────────────────────────────────────────

NOTION_API_KEY=replace-me
NOTION_CONTENT_DATABASE_ID=replace-me
NOTION_PROJECTS_DATABASE_ID=replace-me
NOTION_COMMUNITY_DATABASE_ID=replace-me

# ─────────────────────────────────────────────────────────────
# EMAIL MARKETING - disabled by default
# ─────────────────────────────────────────────────────────────

BEEHIIV_API_KEY=replace-me
BEEHIIV_PUBLICATION_ID=replace-me
KIT_API_KEY=replace-me
KIT_API_SECRET=replace-me

# ─────────────────────────────────────────────────────────────
# SOCIAL MEDIA AUTOMATION - disabled by default
# ─────────────────────────────────────────────────────────────

BUFFER_ACCESS_TOKEN=replace-me
INSTAGRAM_ACCESS_TOKEN=replace-me
INSTAGRAM_BUSINESS_ACCOUNT_ID=replace-me
TIKTOK_CLIENT_KEY=replace-me
TIKTOK_CLIENT_SECRET=replace-me

# ─────────────────────────────────────────────────────────────
# DATABASE & VECTOR SEARCH - disabled by default
# ─────────────────────────────────────────────────────────────

QDRANT_URL=replace-me
QDRANT_API_KEY=replace-me
SUPABASE_URL=replace-me
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_KEY=replace-me

# ─────────────────────────────────────────────────────────────
# CLOUD HOSTING & DEPLOYMENT - manual only
# ─────────────────────────────────────────────────────────────

FLY_API_TOKEN=replace-me
RAILWAY_TOKEN=replace-me

# ─────────────────────────────────────────────────────────────
# ANALYTICS & MONITORING - optional
# ─────────────────────────────────────────────────────────────

POSTHOG_API_KEY=replace-me
POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=replace-me

# ─────────────────────────────────────────────────────────────
# AMAZON KDP & PUBLISHING - optional future promotion tooling
# ─────────────────────────────────────────────────────────────

AMAZON_ADS_CLIENT_ID=replace-me
AMAZON_ADS_CLIENT_SECRET=replace-me
AMAZON_ADS_REFRESH_TOKEN=replace-me

# ─────────────────────────────────────────────────────────────
# KICKSTARTER & CROWDFUNDING - optional future tooling
# ─────────────────────────────────────────────────────────────

KICKSTARTER_API_TOKEN=replace-me

# ─────────────────────────────────────────────────────────────
# SYSTEM CONFIGURATION
# ─────────────────────────────────────────────────────────────

ENVIRONMENT=development
LOG_LEVEL=INFO
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_HOST=127.0.0.1
MAX_TOKENS_PER_REQUEST=4000
DEFAULT_MODEL=replace-with-active-model
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_DAY=1000000

# ─────────────────────────────────────────────────────────────
# WEBHOOK ENDPOINTS - disabled by default
# ─────────────────────────────────────────────────────────────

MAKE_CONTENT_WEBHOOK=replace-me
MAKE_NOTION_SYNC_WEBHOOK=replace-me
MAKE_DISCORD_WEBHOOK=replace-me
ZAPIER_EMAIL_WEBHOOK=replace-me

# ─────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────

ENABLE_DISCORD_BOT=false
ENABLE_NOTION_SYNC=false
ENABLE_EMAIL_AUTOMATION=false
ENABLE_SOCIAL_POSTING=false
ENABLE_ANALYTICS=true
ENABLE_VECTOR_SEARCH=false

# ═══════════════════════════════════════════════════════════════
# SETUP CHECKLIST
# ═══════════════════════════════════════════════════════════════
