{
  "name": "mxd-mda",
  "version": "0.1.0",
  "description": "MXD-MDA transmedia orchestration system",
  "private": true,
  "scripts": {
    "dashboard": "python src/orchestrator/main.py dashboard",
    "dashboard:json": "python src/orchestrator/main.py dashboard --json",
    "dashboard:export": "python src/orchestrator/main.py export-dashboard",
    "sprint:validate": "python src/orchestrator/main.py validate-sprint-state docs/operations/SPRINT_STATE_EXAMPLE_2026-06-05_v01.json",
    "doctor": "python src/orchestrator/main.py doctor",
    "version": "python src/orchestrator/main.py version",
    "test": "pytest -q",
    "qa": "python -m compileall src tests && pytest -q && ruff check src tests && black --check src tests && mypy src tests --ignore-missing-imports",
    "build": "python src/orchestrator/main.py version",
    "sync:shopify:listen": "node scripts/shopify-github-sync/server.js",
    "sync:shopify:bulk": "node scripts/shopify-github-sync/bulk-import.js --bulk",
    "sync:shopify:bulk:dry-run": "node scripts/shopify-github-sync/bulk-import.js --bulk --dry-run",
    "sync:shopify:register-webhook": "node scripts/shopify-github-sync/register-webhook.js"
  },
  "keywords": [
    "mxd-mda",
    "transmedia",
    "orchestration",
    "ai-agents",
    "storytelling"
  ],
  "author": "MXD-MDA",
  "license": "MIT"
}
